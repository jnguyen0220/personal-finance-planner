# Backend configuration. Copy to `.env` and adjust as needed.

# Address and port the server binds to.
HOST=0.0.0.0
PORT=8080

# Directory for the SQLite database and uploaded files.
DATA_DIR=data

# Log filter (tracing EnvFilter syntax).
RUST_LOG=backend=debug,tower_http=info

# Database connection.
# Currently the app uses a local SQLite file under DATA_DIR (data/app.db).
# For a future Postgres integration, set DATABASE_URL instead, e.g.:
# DATABASE_URL=postgres://user:password@localhost:5432/pfp

# Gmail (inbound email via the Gmail API).
# Google no longer issues app passwords, so the backend reads mail with an
# OAuth2 refresh token. In the Google Cloud console: enable the Gmail API,
# create OAuth client credentials, grant the gmail.readonly scope, and complete
# the consent flow once to obtain a refresh token for the mailbox to read.
# Leave the three credentials blank to disable Gmail polling.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Gmail search query selecting which messages to read (default: is:unread).
GMAIL_QUERY=is:unread

# Maximum number of messages to fetch per poll.
GMAIL_MAX_RESULTS=10

# Seconds between inbox polls.
GMAIL_POLL_SECS=300

